# Copy this file to .env and replace placeholders before running locally.

APP_NAME=denoise-backend
APP_ENV=development
DEBUG=true

SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

DATABASE_URL=postgresql+psycopg2://denoise:denoise@localhost:5433/denoise_db
# Deploy (Supabase) — use the SESSION pooler string (port 5432) from the
# dashboard "Connect" dialog, NOT db.<ref>.supabase.co (IPv6-only). Example:
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase — only needed to verify Google OAuth tokens (see /auth/oauth/google).
# Project URL + anon key from Supabase → Settings → API. Leave blank to disable.
SUPABASE_URL=
SUPABASE_ANON_KEY=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set true if you want denoise tasks to run inside the API process without a Celery worker.
CELERY_TASK_ALWAYS_EAGER=false

# Heavy classify/denoise/OCR jobs: "celery" for local/Pod, "runpod" for
# queue-based RunPod Serverless. RUNPOD_* credentials belong on the API only.
INFERENCE_BACKEND=celery
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2
RUNPOD_SUBMIT_TIMEOUT_SECONDS=15
RUNPOD_EXECUTION_TIMEOUT_MS=600000
RUNPOD_JOB_TTL_MS=3600000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/tiff,image/bmp
LOCAL_STORAGE_DIR=storage_data

DENOISING_IMAGE_SIZE=256
DENOISING_BATCH_SIZE=8
DENOISING_WEIGHTS_PATH=

TESSERACT_CMD=tesseract
TESSERACT_LANG=vie+eng

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_QWEN_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Free (viewer) tier provider: 'ollama' | 'openrouter_qwen' | 'openai'
VIEWER_LLM_PROVIDER=ollama
# Local/Cloud Ollama (OpenAI-compatible). Run `ollama serve` + `ollama run <model>` first.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=ollama

SUSPICIOUS_CONFIDENCE_THRESHOLD=70.0

VIEWER_MAX_IMAGES=10
VIEWER_MAX_WORKSPACES=2

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
