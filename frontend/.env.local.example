# Base URL of the FastAPI backend. The frontend will prefix all API calls
# with this value. Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Max upload size for a page image, in MB. Keep this in sync with the backend's
# MAX_UPLOAD_SIZE_MB (the backend is the authoritative check). Defaults to 5.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=5

# Supabase — only used for the Google sign-in handshake (see lib/supabase.ts).
# Project URL + anon (public) key from Supabase → Settings → API. The anon key
# is safe to expose. Leave both blank to hide the "Continue with Google" button.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
