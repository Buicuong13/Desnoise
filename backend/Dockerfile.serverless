# syntax=docker/dockerfile:1
#
# Queue-based RunPod Serverless worker for classify, denoise, and OCR jobs.
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        tesseract-ocr tesseract-ocr-vie tesseract-ocr-eng \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install -r requirements.txt \
    && pip install "tensorflow[and-cuda]==2.17.0" "runpod~=1.7.6"

COPY . .

RUN test -s app/checkpoints/classifier/best_mobilenetv3_small_document_classifier.pth \
    && test -s app/checkpoints/denoising/best_generator.weights.h5 \
    && test -s app/checkpoints/layout/doclayout_yolo_docstructbench_imgsz1024.pt

ENV TESSERACT_CMD=tesseract \
    LAYOUT_DEVICE=cuda \
    TF_FORCE_GPU_ALLOW_GROWTH=true

CMD ["python", "-u", "-m", "app.runpod_handler"]
