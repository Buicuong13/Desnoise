# Runtime variables for the RunPod Serverless endpoint.
# Add these in RunPod Endpoint -> Settings -> Environment Variables.

APP_ENV=production
DEBUG=false
SECRET_KEY=required-by-app-settings-but-not-used-by-the-handler

# Use the Supabase pooler connection string, not an IPv6-only direct host.
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLASSIFIER_ENABLED=true
CLASSIFIER_CONFIDENCE_THRESHOLD=0.5
LAYOUT_ENABLED=true
LAYOUT_DEVICE=cuda
TF_FORCE_GPU_ALLOW_GROWTH=true
TESSERACT_CMD=tesseract
TESSERACT_LANG=vie+eng
TESSERACT_PSM=6
SUSPICIOUS_CONFIDENCE_THRESHOLD=70.0
